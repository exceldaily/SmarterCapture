# Public origin used only to build trusted Stripe return URLs.
APP_URL=http://localhost:3000

# Protects /admin/* with HTTP Basic authentication.
ADMIN_ACCESS_USER=
ADMIN_ACCESS_PASSWORD=

# Server-only Stripe credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order storage: direct Postgres connection as the dedicated smartercapture_app
# role, scoped to the smartercapture schema of the shared OrbitStack database.
# Must use the IPv4 pooler host (aws-0-<region>.pooler.supabase.com:6543) —
# the direct db.<ref> host is IPv6-only, which serverless cannot reach.
# There is no Supabase auth or platform key anywhere in this app.
DATABASE_URL=
